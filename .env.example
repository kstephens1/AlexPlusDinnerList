# Copy this file to .env and fill in values before running scripts/deploy.sh.

PROJECT_NAME=alexa-plus-dinner-list
AWS_REGION=us-east-1
AWS_PROFILE=default

# Optional. If empty, deploy.sh creates or updates PROJECT_NAME.
LAMBDA_FUNCTION_NAME=alexa-plus-dinner-list
LAMBDA_ROLE_NAME=alexa-plus-dinner-list-lambda-role

# Optional. Defaults to PROJECT_NAME-account-region when empty.
S3_BUCKET_NAME=
MENU_KEY=dinner-menu/items.json
TARGETS_KEY=dinner-menu/targets.json

# Optional for the first Lambda-only deploy. Set this after the Alexa skill exists
# so deploy.sh can add the Alexa Skills Kit invoke permission to Lambda.
ALEXA_SKILL_ID=

# Optional manual fallback for Alexa Data Store updates.
# When ALEXA_SKILL_ID is set, deploy.sh fetches these skill messaging
# credentials from ASK and writes them into the deployed Lambda environment.
ALEXA_SKILL_CLIENT_ID=
ALEXA_SKILL_CLIENT_SECRET=

# Optional. Set to 1 after you have configured ASK CLI and reviewed skill-package/.
DEPLOY_SKILL=0
ASK_PROFILE=default

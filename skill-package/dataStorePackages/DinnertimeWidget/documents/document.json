{
  "type": "APL",
  "version": "2024.3",
  "extensions": [
    {
      "name": "DataStore",
      "uri": "alexaext:datastore:10"
    }
  ],
  "settings": {
    "DataStore": {
      "dataBindings": [
        {
          "namespace": "Dinnertime",
          "key": "state",
          "dataBindingName": "DS_DinnertimeState",
          "dataType": "OBJECT"
        },
        {
          "namespace": "Dinnertime",
          "key": "items",
          "dataBindingName": "DS_DinnertimeItems",
          "dataType": "ARRAY",
          "startIndex": 0,
          "endIndex": 49
        },
        {
          "namespace": "Dinnertime",
          "key": "meta",
          "dataBindingName": "DS_DinnertimeMeta",
          "dataType": "OBJECT"
        }
      ]
    }
  },
  "theme": "dark",
  "mainTemplate": {
    "parameters": [
      "dinnerList"
    ],
    "items": [
      {
        "type": "TouchWrapper",
        "onPress": [
          {
            "type": "SendEvent",
            "arguments": [
              "openFullScreen"
            ],
            "flags": {
              "interactionMode": "STANDARD"
            }
          }
        ],
        "item": {
          "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "paddingLeft": 16,
        "paddingRight": 16,
        "paddingTop": 12,
        "paddingBottom": 10,
        "backgroundColor": "#17202A",
        "items": [
          {
            "type": "Text",
            "text": "${DS_DinnertimeState.title || DS_DinnertimeMeta.title || dinnerList.title}",
            "fontSize": 24,
            "fontWeight": "700",
            "color": "#FFFFFF",
            "maxLines": 1
          },
          {
            "type": "Sequence",
            "height": "76vh",
            "paddingTop": 6,
            "scrollDirection": "vertical",
            "data": "${DS_DinnertimeItems.length > 0 ? DS_DinnertimeItems : (DS_DinnertimeState.items && DS_DinnertimeState.items.length > 0 ? DS_DinnertimeState.items : dinnerList.items)}",
            "items": [
              {
                "type": "Container",
                "minHeight": 48,
                "paddingTop": 5,
                "paddingBottom": 5,
                "direction": "row",
                "alignItems": "start",
                "items": [
                  {
                    "type": "Frame",
                    "width": 8,
                    "height": 8,
                    "borderRadius": 4,
                    "backgroundColor": "#58D68D",
                    "marginTop": 7
                  },
                  {
                    "type": "Text",
                    "width": 40,
                    "paddingLeft": 8,
                    "text": "${data.day}",
                    "fontSize": 13,
                    "fontWeight": "700",
                    "color": "#D5DBDB",
                    "maxLines": 1,
                    "paddingTop": 1
                  },
                  {
                    "type": "Text",
                    "paddingLeft": 4,
                    "width": 0,
                    "grow": 1,
                    "shrink": 1,
                    "text": "${data.text}",
                    "fontSize": 16,
                    "fontWeight": "600",
                    "color": "#FFFFFF"
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "height": 22,
            "direction": "row",
            "items": [
              {
                "type": "Text",
                "text": "v1.0.19",
                "fontSize": 12,
                "color": "#AAB7B8",
                "grow": 1,
                "maxLines": 1
              },
              {
                "type": "Text",
                "text": "${DS_DinnertimeItems.length > 0 || (DS_DinnertimeState.items && DS_DinnertimeState.items.length > 0) ? 'Live' : 'Fallback'} - Updated ${DS_DinnertimeMeta.lastUpdated || DS_DinnertimeState.lastUpdated || dinnerList.lastUpdated} ${DS_DinnertimeMeta.lastUpdatedTime || DS_DinnertimeState.lastUpdatedTime || dinnerList.lastUpdatedTime}",
                "fontSize": 12,
                "color": "#AAB7B8",
                "grow": 1,
                "textAlign": "right",
                "maxLines": 1
              }
            ]
          }
        ]
        }
      }
    ]
  }
}
